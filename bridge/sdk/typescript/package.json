{
  "name": "@synaptic/sdk",
  "version": "0.1.0",
  "description": "Tiny client for emitting Synaptic activity events from any TypeScript or JavaScript agent or instrumentation.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": ["dist", "src", "README.md"],
  "scripts": {
    "build": "tsc",
    "prepublishOnly": "npm run build"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "synaptic",
    "observability",
    "dashboard",
    "ai-agents"
  ],
  "author": "Anthony Dragone",
  "license": "SEE LICENSE IN ../../../LICENSE",
  "devDependencies": {
    "@types/node": "^20.0.0",
    "typescript": "^5.4.0"
  }
}
